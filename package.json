{
  "name": "knights-tour-game",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run check:types && vite build",
    "preview": "vite preview",
    "inspect": "VITE_INSPECT_XSTATE=1 npm run dev",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run",
    "prepare": "husky install",
    "format": "prettier --write .",
    "check:types": "tsc --noEmit",
    "cy:open": "cypress open",
    "cy:run": "cypress run"
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "@headlessui/react": "1.7.5",
    "@heroicons/react": "1.0.6",
    "@microsoft/fast-react-wrapper": "0.3.15",
    "@testing-library/react-hooks": "7.0.2",
    "@types/node": "24.13.3",
    "@types/react": "17.0.52",
    "@types/react-dom": "17.0.18",
    "@vitejs/plugin-react": "6.0.5",
    "@xstate/inspect": "0.6.1",
    "@xstate/react": "1.6.3",
    "autoprefixer": "10.4.13",
    "classnames": "2.3.2",
    "cypress": "15.20.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "6.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "2.25.0",
    "focus-visible": "5.2.0",
    "framer-motion": "6.5.1",
    "gchessboard": "1.0.0",
    "globals": "17.9.0",
    "husky": "7.0.4",
    "immutable": "4.1.0",
    "jsdom": "30.0.1",
    "lint-staged": "12.5.0",
    "mockdate": "3.0.5",
    "postcss": "8.4.20",
    "postcss-focus-visible": "6.0.4",
    "prettier": "2.8.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-test-renderer": "17.0.2",
    "react-use": "17.4.0",
    "runtypes": "6.6.0",
    "tailwindcss": "3.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wait-for-expect": "3.0.2",
    "xstate": "4.28.1"
  },
  "prettier": {
    "semi": false,
    "proseWrap": "always"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
